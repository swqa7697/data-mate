{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "driver": {
            "const": "postgres"
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00]+$"
          },
          "scope": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "all"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "selected"
                  },
                  "schemas": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\x00]+$",
                      "maxLength": 63
                    },
                    "uniqueItems": true
                  },
                  "tables": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "schema": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^\\x00]+$",
                          "maxLength": 63
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^\\x00]+$",
                          "maxLength": 63
                        }
                      },
                      "required": [
                        "schema",
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "alias",
          "driver",
          "database",
          "scope"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    }
  },
  "required": [
    "connections"
  ],
  "additionalProperties": false
}
