{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "driver": {
            "const": "postgres"
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00]+$"
          }
        },
        "required": [
          "alias",
          "driver",
          "database"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    }
  },
  "required": [
    "connections"
  ],
  "additionalProperties": false
}
