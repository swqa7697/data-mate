{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "driver": {
            "type": "string",
            "enum": [
              "postgres",
              "mysql",
              "mariadb",
              "redis"
            ]
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "description": "PostgreSQL database name or Redis logical database index. MySQL and MariaDB expose databases through account grants."
          },
          "limits": {
            "type": "object",
            "description": "Current finite Data Mate execution limits for this connection. Optional budgets appear only when enabled.",
            "properties": {
              "max_rows": {
                "type": "integer",
                "minimum": 1,
                "description": "Maximum query rows or Redis entries returned per call."
              },
              "max_result_bytes": {
                "type": "integer",
                "minimum": 1,
                "description": "Maximum bytes in the complete MCP tool result for query and metadata tools, including structuredContent, text content and escaping, without the JSON-RPC wrapper."
              },
              "query_timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "description": "Execution timeout in milliseconds for query and metadata tools, including credential loading, driver admission, connection setup, execution and result reading. Earlier caller and database deadlines still apply."
              }
            },
            "required": [
              "max_rows"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "alias",
          "driver",
          "limits"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "driver": {
                  "enum": [
                    "postgres",
                    "redis"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "database"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "database"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "driver": {
                  "const": "redis"
                }
              }
            },
            "then": {
              "properties": {
                "database": {
                  "pattern": "^(0|[1-9][0-9]{0,9})$",
                  "description": "Redis logical database index in canonical decimal, from 0 to 2147483647."
                }
              }
            }
          }
        ]
      },
      "maxItems": 128
    }
  },
  "required": [
    "connections"
  ],
  "additionalProperties": false
}
