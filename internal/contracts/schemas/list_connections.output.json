{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "driver": {
            "type": "string",
            "enum": [
              "postgres",
              "mysql",
              "mariadb"
            ]
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "description": "PostgreSQL only: the profile's database. MySQL and MariaDB connections reach every database their grants allow."
          }
        },
        "required": [
          "alias",
          "driver"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "driver": {
                  "const": "postgres"
                }
              }
            },
            "then": {
              "required": [
                "database"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "database"
                ]
              }
            }
          }
        ]
      },
      "maxItems": 128
    }
  },
  "required": [
    "connections"
  ],
  "additionalProperties": false
}
