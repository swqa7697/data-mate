{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "driver": {
            "type": "string",
            "enum": [
              "postgres",
              "mysql",
              "mariadb"
            ]
          },
          "connection": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "database": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$"
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$"
              }
            },
            "required": [
              "host",
              "port",
              "username"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "alias",
          "driver",
          "connection"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "driver": {
                  "const": "postgres"
                }
              }
            },
            "then": {
              "properties": {
                "connection": {
                  "required": [
                    "database"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "connection": {
                  "not": {
                    "required": [
                      "database"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "connections"
  ],
  "additionalProperties": false
}
