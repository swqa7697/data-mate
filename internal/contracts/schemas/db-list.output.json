{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "driver": {
            "const": "postgres"
          },
          "connection": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "database": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$"
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$"
              }
            },
            "required": [
              "host",
              "port",
              "database",
              "username"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "blacklist",
                  "whitelist"
                ]
              },
              "schemas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\x00]+$",
                  "maxLength": 63
                },
                "uniqueItems": true,
                "maxItems": 4096
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "alias",
          "driver",
          "connection",
          "scope"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "connections"
  ],
  "additionalProperties": false
}
