{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "driver": {
      "const": "redis"
    },
    "key": {
      "$ref": "#/$defs/bytes"
    },
    "type": {
      "enum": [
        "string",
        "hash",
        "list",
        "set",
        "zset",
        "stream",
        "none"
      ]
    },
    "items": {
      "type": "array"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  },
  "required": [
    "connection",
    "driver",
    "key",
    "type",
    "items",
    "next_cursor"
  ],
  "additionalProperties": false,
  "$defs": {
    "bytes": {
      "type": "object",
      "properties": {
        "encoding": {
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "encoding",
        "value"
      ],
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/bytes"
        },
        "value": {
          "$ref": "#/$defs/bytes"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "none"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "string"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/bytes"
            },
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "list",
              "set"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/bytes"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "hash"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pair"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "zset"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "member": {
                  "$ref": "#/$defs/bytes"
                },
                "score": {
                  "type": "string"
                }
              },
              "required": [
                "member",
                "score"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "stream"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/pair"
                  }
                }
              },
              "required": [
                "id",
                "fields"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
