{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "routine",
        "type",
        "sequence",
        "function",
        "procedure"
      ]
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "maxLength": 64
    },
    "identity_arguments": {
      "type": "string",
      "maxLength": 65536,
      "pattern": "^[^\\x00]*$",
      "description": "PostgreSQL routines only: the exact identity_arguments from list_objects, including an empty string for zero arguments."
    }
  },
  "required": [
    "connection",
    "kind",
    "schema",
    "name"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "routine"
        }
      },
      "required": [
        "identity_arguments"
      ]
    },
    {
      "properties": {
        "kind": {
          "enum": [
            "type",
            "sequence",
            "function",
            "procedure"
          ]
        }
      },
      "not": {
        "required": [
          "identity_arguments"
        ]
      }
    }
  ]
}
