{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Catalog-visible relations. The shape follows the connection's driver; for MySQL and MariaDB a schema is a database.",
  "type": "object",
  "required": [
    "driver"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "driver": {
          "const": "postgres"
        },
        "connection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$",
                "maxLength": 64
              },
              "kind": {
                "type": "string",
                "enum": [
                  "table",
                  "partitioned_table",
                  "view",
                  "materialized_view",
                  "foreign_table",
                  "other"
                ]
              }
            },
            "required": [
              "schema",
              "name",
              "kind"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "driver",
        "connection",
        "tables",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "connection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "driver": {
          "enum": [
            "mysql",
            "mariadb"
          ]
        },
        "tables": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$",
                "maxLength": 64
              },
              "kind": {
                "type": "string",
                "enum": [
                  "table",
                  "view",
                  "system_view",
                  "system_versioned_table",
                  "other"
                ]
              }
            },
            "required": [
              "schema",
              "name",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "connection",
        "driver",
        "tables",
        "next_cursor"
      ],
      "additionalProperties": false
    }
  ]
}
