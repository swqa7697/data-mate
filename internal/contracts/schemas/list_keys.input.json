{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "pattern": {
      "type": "string"
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "connection"
  ],
  "additionalProperties": false
}
