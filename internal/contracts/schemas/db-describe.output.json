{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "driver": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis"
      ]
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\x00]+$"
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                },
                "kind": {
                  "enum": [
                    "table",
                    "partitioned_table",
                    "view",
                    "materialized_view",
                    "foreign_table",
                    "system_versioned_table"
                  ]
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "enums": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "sequences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                },
                "table": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\x00]+$",
                  "maxLength": 64
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "tables",
          "enums",
          "sequences",
          "indexes",
          "functions"
        ],
        "additionalProperties": false
      }
    },
    "keyspace": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "driver": {
          "const": "redis"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "object",
                "properties": {
                  "encoding": {
                    "enum": [
                      "utf8",
                      "base64"
                    ]
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "encoding",
                  "value"
                ],
                "additionalProperties": false
              },
              "type": {
                "enum": [
                  "string",
                  "hash",
                  "list",
                  "set",
                  "zset",
                  "stream"
                ]
              }
            },
            "required": [
              "key",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "connection",
        "driver",
        "keys",
        "next_cursor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "alias",
    "driver"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "driver": {
            "enum": [
              "postgres",
              "redis"
            ]
          }
        }
      },
      "then": {
        "required": [
          "database"
        ]
      },
      "else": {
        "not": {
          "required": [
            "database"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "driver": {
            "const": "redis"
          }
        }
      },
      "then": {
        "properties": {
          "database": {
            "pattern": "^(0|[1-9][0-9]{0,9})$",
            "description": "Redis logical database index in canonical decimal, from 0 to 2147483647."
          }
        },
        "required": [
          "keyspace"
        ],
        "not": {
          "required": [
            "schemas"
          ]
        }
      },
      "else": {
        "required": [
          "schemas"
        ],
        "not": {
          "required": [
            "keyspace"
          ]
        }
      }
    }
  ]
}
