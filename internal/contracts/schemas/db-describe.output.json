{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "driver": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "mariadb"
      ]
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "schemas": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\x00]+$"
          },
          "tables": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                },
                "kind": {
                  "enum": [
                    "table",
                    "partitioned_table",
                    "view",
                    "materialized_view",
                    "foreign_table",
                    "system_versioned_table"
                  ]
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "enums": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "sequences": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "indexes": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                },
                "table": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\x00]+$",
                  "maxLength": 64
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "functions": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "tables",
          "enums",
          "sequences",
          "indexes",
          "functions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "alias",
    "driver",
    "schemas"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "driver": {
            "const": "postgres"
          }
        }
      },
      "then": {
        "required": [
          "database"
        ]
      },
      "else": {
        "not": {
          "required": [
            "database"
          ]
        }
      }
    }
  ]
}
