{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "driver": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis",
        "mongodb"
      ]
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\x00]+$"
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[^\\x00]+$"
                },
                "kind": {
                  "enum": [
                    "table",
                    "partitioned_table",
                    "view",
                    "materialized_view",
                    "foreign_table",
                    "system_versioned_table",
                    "collection",
                    "timeseries",
                    "other"
                  ]
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "enums": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "sequences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\x00]+$"
                },
                "table": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\x00]+$",
                  "maxLength": 255
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\x00]+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "tables",
          "enums",
          "sequences",
          "indexes",
          "functions"
        ],
        "additionalProperties": false
      }
    },
    "keyspace": {
      "type": "object",
      "properties": {
        "observed_keys": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "groups": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 3,
                "pattern": ":\\*$"
              },
              "type": {
                "enum": [
                  "string",
                  "hash",
                  "list",
                  "set",
                  "zset",
                  "stream"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "encoding": {
                      "enum": [
                        "utf8",
                        "base64"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "truncated": {
                      "const": true
                    }
                  },
                  "required": [
                    "encoding",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "count"
            ],
            "additionalProperties": false,
            "not": {
              "required": [
                "pattern",
                "examples"
              ]
            }
          }
        }
      },
      "required": [
        "observed_keys",
        "groups"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "alias",
    "driver"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "driver": {
            "enum": [
              "postgres",
              "redis"
            ]
          }
        }
      },
      "then": {
        "required": [
          "database"
        ]
      },
      "else": {
        "not": {
          "required": [
            "database"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "driver": {
            "const": "redis"
          }
        }
      },
      "then": {
        "properties": {
          "database": {
            "pattern": "^(0|[1-9][0-9]{0,9})$",
            "description": "Redis logical database index in canonical decimal, from 0 to 2147483647."
          },
          "version": {
            "const": 2
          }
        },
        "required": [
          "keyspace"
        ],
        "not": {
          "required": [
            "schemas"
          ]
        }
      },
      "else": {
        "required": [
          "schemas"
        ],
        "not": {
          "required": [
            "keyspace"
          ]
        },
        "properties": {
          "version": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "driver": {
            "const": "mongodb"
          }
        }
      },
      "then": {
        "properties": {
          "schemas": {
            "items": {
              "properties": {
                "tables": {
                  "items": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "collection",
                          "view",
                          "timeseries",
                          "other"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "schemas": {
            "items": {
              "properties": {
                "tables": {
                  "items": {
                    "properties": {
                      "name": {
                        "maxLength": 64
                      },
                      "kind": {
                        "enum": [
                          "table",
                          "partitioned_table",
                          "view",
                          "materialized_view",
                          "foreign_table",
                          "system_versioned_table"
                        ]
                      }
                    }
                  }
                },
                "indexes": {
                  "items": {
                    "properties": {
                      "name": {
                        "maxLength": 64
                      },
                      "table": {
                        "maxLength": 64
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
