{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "driver": {
      "const": "redis"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "object",
            "properties": {
              "encoding": {
                "enum": [
                  "utf8",
                  "base64"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "encoding",
              "value"
            ],
            "additionalProperties": false
          },
          "type": {
            "enum": [
              "string",
              "hash",
              "list",
              "set",
              "zset",
              "stream"
            ]
          }
        },
        "required": [
          "key",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  },
  "required": [
    "connection",
    "driver",
    "keys",
    "next_cursor"
  ],
  "additionalProperties": false
}
