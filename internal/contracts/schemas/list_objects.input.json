{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "maxLength": 64
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "kind": {
      "type": "string",
      "enum": [
        "routine",
        "type",
        "sequence",
        "function",
        "procedure"
      ],
      "description": "PostgreSQL: routine, type or sequence. MySQL: function or procedure. MariaDB: function, procedure or sequence."
    }
  },
  "required": [
    "connection"
  ],
  "additionalProperties": false
}
