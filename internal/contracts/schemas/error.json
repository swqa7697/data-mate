{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "CONFIG_INVALID",
            "CONNECTION_NOT_FOUND",
            "CREDENTIAL_MISSING",
            "VAULT_UNAVAILABLE",
            "CONNECT_FAILED",
            "SCOPE_DENIED",
            "QUERY_UNSUPPORTED",
            "QUERY_TIMEOUT",
            "RESOURCE_LIMIT",
            "STALE_CURSOR",
            "INVALID_ARGUMENT",
            "SERVICE_UNAVAILABLE",
            "CANCELLED",
            "READ_ONLY_VIOLATION",
            "PERMISSION_DENIED",
            "QUERY_FAILED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "sqlstate": {
          "type": "string",
          "pattern": "^[0-9A-Z]{5}$"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
