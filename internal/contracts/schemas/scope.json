{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "blacklist",
        "whitelist"
      ]
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\x00]+$",
        "maxLength": 63
      },
      "uniqueItems": true,
      "maxItems": 4096
    }
  },
  "required": [
    "mode"
  ],
  "additionalProperties": false
}
