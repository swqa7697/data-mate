{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "ok": {
            "type": "boolean"
          },
          "stage": {
            "enum": [
              "config",
              "vault",
              "dial",
              "authentication",
              "version",
              "read_only"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "CONNECTION_NOT_FOUND",
                  "CREDENTIAL_MISSING",
                  "VAULT_UNAVAILABLE",
                  "CONNECT_FAILED",
                  "SCOPE_DENIED",
                  "QUERY_UNSUPPORTED",
                  "QUERY_TIMEOUT",
                  "RESOURCE_LIMIT",
                  "STALE_CURSOR",
                  "INVALID_ARGUMENT",
                  "SERVICE_UNAVAILABLE",
                  "CANCELLED",
                  "READ_ONLY_VIOLATION",
                  "PERMISSION_DENIED",
                  "QUERY_FAILED"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\x00]+$"
              },
              "retryable": {
                "type": "boolean"
              },
              "sqlstate": {
                "type": "string",
                "pattern": "^[0-9A-Z]{5}$"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          },
          "stages": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "object",
              "properties": {
                "stage": {
                  "enum": [
                    "config",
                    "vault",
                    "dial",
                    "authentication",
                    "version",
                    "read_only"
                  ]
                },
                "ok": {
                  "type": "boolean"
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "CONFIG_INVALID",
                        "CONNECTION_NOT_FOUND",
                        "CREDENTIAL_MISSING",
                        "VAULT_UNAVAILABLE",
                        "CONNECT_FAILED",
                        "SCOPE_DENIED",
                        "QUERY_UNSUPPORTED",
                        "QUERY_TIMEOUT",
                        "RESOURCE_LIMIT",
                        "STALE_CURSOR",
                        "INVALID_ARGUMENT",
                        "SERVICE_UNAVAILABLE",
                        "CANCELLED",
                        "READ_ONLY_VIOLATION",
                        "PERMISSION_DENIED",
                        "QUERY_FAILED"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\x00]+$"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "sqlstate": {
                      "type": "string",
                      "pattern": "^[0-9A-Z]{5}$"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "stage",
                "ok"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "alias",
          "ok",
          "stage",
          "stages"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "results"
  ],
  "additionalProperties": false
}
