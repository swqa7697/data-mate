{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "state": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "degraded",
        "stale"
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "state": {
            "enum": [
              "unavailable",
              "disabled",
              "pending",
              "ready",
              "conflict",
              "failed"
            ]
          }
        },
        "required": [
          "name",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "mcp_enabled": {
      "type": "boolean"
    },
    "keyset_state": {
      "enum": [
        "absent",
        "locked",
        "ready",
        "unavailable"
      ]
    }
  },
  "required": [
    "version",
    "state",
    "agents",
    "mcp_enabled",
    "keyset_state"
  ],
  "additionalProperties": false
}
