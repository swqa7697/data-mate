{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "database": {
      "type": "string",
      "pattern": "^[^/\\\\. \"$\\x00]{1,63}$",
      "description": "Exact MongoDB database that holds the collection."
    },
    "collection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^$\\x00]+$",
      "description": "Exact collection, view or time-series collection name."
    }
  },
  "required": [
    "connection",
    "database",
    "collection"
  ],
  "additionalProperties": false
}
